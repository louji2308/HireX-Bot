{
  "name": "hirex-bot",
  "version": "0.1.0",
  "private": true,
  "description": "HireX Bot - autonomous proof-of-work, apprenticeship and employment architecture for India's youth tech workforce.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"$env:HIREX_DB_REQUIRED='1'; npx vitest run tests/phase2\"",
    "pg:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-up.ps1",
    "pg:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-down.ps1",
    "pg:verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pg-verify.ps1",
    "test:sandbox": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sandbox-up.ps1 -RunTests",
    "sandbox:up": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sandbox-up.ps1 -KeepAlive",
    "sandbox:down": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sandbox-up.ps1 -Down",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "inngest": "^4.25.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "fast-check": "^3.23.2",
    "pg": "^8.23.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
