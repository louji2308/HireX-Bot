# Copy to .env.local for local development. Never commit real credentials.

# Code execution sandbox (ADR-006). The default is the self-hosted Piston
# reachable from Windows via WSL2 localhost forwarding. The public host answers
# /runtimes but returns 401 on /execute, so it is never the default.
PISTON_BASE_URL=http://127.0.0.1:2000/api/v2

# Optional ordered fallbacks, comma-separated. Each endpoint is probed
# independently; a dead primary does not make a healthy secondary look down.
# PISTON_FALLBACK_BASE_URLS=http://127.0.0.1:2001/api/v2

# Non-loopback endpoints are refused unless this is exactly "1". Candidate source
# code must not be posted to an unknown third party by accident.
# PISTON_ALLOW_REMOTE=

# Languages the product may offer. Defaults to python,javascript, the two
# runtimes actually installed and probed on the demo host.
# PISTON_ALLOWED_LANGUAGES=python,javascript

# Live sandbox tests are opt-in so the default `npm test` gate needs no container.
# PISTON_LIVE=1

# SMART-Code dual-lab gateway (ADR-002). Values are not yet verified; the router
# refuses to claim a provider succeeded without evidence.
# SMART_CODE_BASE_URL=
# SMART_CODE_API_KEY=

# Optional episodic memory backend. Without this, failures are stored in the
# append-only JSONL ledger at swarm/memory/failure_memories.jsonl.
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=first_mile_failure_memories
