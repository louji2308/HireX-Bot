# Copy to .env.local for local development. Never commit real credentials.

# Code execution sandbox (ADR-006). The default is the self-hosted Piston
# reachable from Windows via WSL2 localhost forwarding. The public host answers
# /runtimes but returns 401 on /execute, so it is never the default.
PISTON_BASE_URL=http://127.0.0.1:2000/api/v2

# Optional ordered fallbacks, comma-separated. Each endpoint is probed
# independently; a dead primary does not make a healthy secondary look down.
# PISTON_FALLBACK_BASE_URLS=http://127.0.0.1:2001/api/v2

# Non-loopback endpoints are refused unless this is exactly "1". Candidate source
# code must not be posted to an unknown third party by accident.
# PISTON_ALLOW_REMOTE=

# Languages the product may offer. Defaults to python,javascript, the two
# runtimes actually installed and probed on the demo host.
# PISTON_ALLOWED_LANGUAGES=python,javascript

# Live sandbox tests are opt-in so the default `npm test` gate needs no container.
# PISTON_LIVE=1

# SMART-Code dual-lab gateway (ADR-002). Values are not yet verified; the router
# refuses to claim a provider succeeded without evidence.
# SMART_CODE_BASE_URL=
# SMART_CODE_API_KEY=

# Optional episodic memory backend. Without this, failures are stored in the
# append-only JSONL ledger at swarm/memory/failure_memories.jsonl.
# QDRANT_URL=
# QDRANT_API_KEY=
# QDRANT_COLLECTION=hirex_bot_failure_memories

# Supabase (Phase 2 persistence substrate). Project ref: krmstikdkjmplhrbtiqs.
# The anon key is publishable; the service-role key is server-only and must
# never appear in a NEXT_PUBLIC_* variable or a client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token vault keyring (AES-256-GCM, app-level). JSON object of kid -> base64
# 32-byte key. Rotate by adding a new kid; TOKEN_VAULT_ACTIVE_KID selects the
# write key. Ciphertext carries its own kid so old rows stay readable.
# TOKEN_VAULT_KEYS={"v1":"<base64-32-bytes>"}
# TOKEN_VAULT_ACTIVE_KID=v1

# LLM consolidation (required for production memory.jsonl facts).
# Use the AgentFoundry SMART-Code gateway (or any OpenAI-compatible endpoint).
# HIREX_LLM_BASE_URL must include the version segment, e.g. https://host/v1.
# SMART_CODE_API_KEY / SMART_CODE_BASE_URL are accepted as aliases.
HIREX_LLM_BASE_URL=
HIREX_LLM_API_KEY=
# Optional provider-specific model ids. Router wire ids are claude-haiku-4-5
# (conversation/extraction) and gpt-5-codex (analysis/grading).
# HIREX_LLM_MODEL_HAIKU=
# HIREX_LLM_MODEL_CODEX=
# Set to 1 only when the SMART-Code grant size has been verified.
# HIREX_LLM_GRANT_VERIFIED=

# Local PostgreSQL harness (scripts/pg-up.ps1). Tests connect as the
# least-privilege hirex_app role; admin URL is used only to reset the schema.
# HIREX_DB_URL=postgresql://hirex_app:hirex@127.0.0.1:55432/hirex_test
# HIREX_DB_ADMIN_URL=postgresql://postgres:hirex@127.0.0.1:55432/hirex_test
# Set to 1 in CI to fail instead of skipping database suites when PG is down.
# HIREX_DB_REQUIRED=

# Inngest serve endpoint. Set INNGEST_DEV=1 only for local/self-hosted verification.
# INNGEST_DEV=1
# Production requires the server-only signing key; never expose it as NEXT_PUBLIC_*.
# INNGEST_SIGNING_KEY=
# Server-only key for sending catalog events.
# INNGEST_EVENT_KEY=
